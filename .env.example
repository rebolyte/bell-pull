# App config
PUBLIC_PORT=8000
ADMIN_PORT=8001
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4196
DATABASE_PATH=bell-pull.db
# DATABASE_PATH=/app/data/bell-pull.db # set on VPS
RATE_LIMIT_DELAY_MS=500
LOG_LEVEL=info
APP_ENV=dev

# Deployment (local .env only, not needed on VPS)
VPS_IP=your-vps-ip
VPS_USER=root
VPS_SSH_PORT=22
# location of docker-compose.yml
VPS_COMPOSE_DIR=/var/traefik
