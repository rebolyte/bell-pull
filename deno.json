{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "name": "bell-pull",
  "version": "2026.01.6",
  "description": "A Telegram bot that sends daily briefings and reminders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rebolyte/bell-pull"
  },
  "exports": {},
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.70.1",
    "@logtape/hono": "jsr:@logtape/hono@^1.3.5",
    "@logtape/logtape": "jsr:@logtape/logtape@^1.3.5",
    "@logtape/pretty": "jsr:@logtape/pretty@^1.3.5",
    "@logtape/redaction": "jsr:@logtape/redaction@^2.0.2",
    "@remeda/remeda": "jsr:@remeda/remeda@^2.32.0",
    "@std/cli": "jsr:@std/cli@^1.0.6",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@zod/zod": "jsr:@zod/zod@^4.1.12",
    "arctic": "npm:arctic@^3.7.0",
    "grammy": "npm:grammy@^1.38.4",
    "hono": "jsr:@hono/hono@^4.10.6",
    "capnweb": "npm:capnweb@^0.4.0",
    "kysely": "npm:kysely@^0.28.8",
    "luxon": "npm:luxon@^3.4.4",
    "msw": "npm:msw@^2.12.7",
    "neverthrow": "npm:neverthrow@^8.2.0",
    "node-cron": "npm:node-cron@^4.2.1",
    "rss-parser": "npm:rss-parser@^3.13.0",
    "ts-pattern": "npm:ts-pattern@^5.9.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
